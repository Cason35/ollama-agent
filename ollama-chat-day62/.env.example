# ollama-chat-day62 环境变量示例
# 使用方式：复制本文件为 .env.local，然后按你的本地环境填写真实值。

# =========================
# 本地 Ollama 聊天模型
# =========================
# 普通聊天、Workflow、RAG 最终回答调用的 Ollama chat API 地址。
OLLAMA_API_URL=http://localhost:11434/api/chat

# 普通聊天、Workflow、RAG 最终回答使用的本地模型名称。
# 需要你本地已执行类似命令：ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b

# 模型请求超时时间，Day62 配置中心会映射到 model.requestTimeoutMs。
MODEL_REQUEST_TIMEOUT_MS=30000

# =========================
# 本地 Ollama Embedding 模型
# =========================
# 知识库导入和 RAG 检索时生成 embedding 的 Ollama 根地址。
OLLAMA_BASE_URL=http://localhost:11434

# 当前代码默认使用 nomic-embed-text。
# 需要你本地已执行：ollama pull nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =========================
# Day62 RAG 配置中心参数
# =========================
# 第一阶段向量召回候选数量，对应 retrieval.recallK。
RAG_RECALL_K=20

# 最终返回给回答链路的片段数量，对应 retrieval.topK。
RAG_TOP_K=5

# 检索结果最低分阈值，对应 retrieval.minScore。
RAG_MIN_SCORE=0.3

# Query Rewrite 最大扩展查询数量，对应 retrieval.maxQueries。
RAG_MAX_QUERIES=5

# =========================
# MySQL Workflow 后端持久化
# =========================
# 右上角 Storage 选择 backend 时会使用这些配置。
# 请先执行 scripts/init-mysql.sql 初始化数据库表。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=agent_runtime

# =========================
# Redis 共享状态中心
# =========================
# Day62 继续用于 RedisClient、RedisCacheStore、RedisQueueStore、RedisLockProvider、Redis Explorer、Queue Explorer 和 Lock Explorer。
REDIS_URL=redis://127.0.0.1:6379

# Redis Key Prefix（键前缀），用于隔离 Day62 示例数据。
REDIS_KEY_PREFIX=ollama:day62:

# Redis 操作超时毫秒数；本机未启动 Redis 时可快速失败并降级。
REDIS_TIMEOUT_MS=800

# Redis Queue Visibility Timeout（可见性超时）毫秒数。
QUEUE_VISIBILITY_TIMEOUT_MS=30000

# Redis Distributed Lock TTL（分布式锁存活时间）毫秒数。
LOCK_TTL_MS=30000

# WorkerPool 最大并发 Worker 数，对应 runtime.maxWorkers。
RUNTIME_MAX_WORKERS=3

# 默认任务超时时间，对应 runtime.jobTimeoutMs。
JOB_TIMEOUT_MS=30000

# 可选：设置为 memory 时强制 Semantic Cache 使用内存 Store。
# CACHE_STORE=memory

# =========================
# Object Storage 对象存储
# =========================
# 默认 local 会写入 .data/object-storage，设置为 minio 后使用 MinIO SDK 访问对象存储。
OBJECT_STORAGE_PROVIDER=local

# Day62 默认 Bucket（存储桶），建议在 MinIO 控制台创建同名 Bucket。
OBJECT_STORAGE_BUCKET=agent-platform

# MinIO API Endpoint（对象存储 API 地址），不是 Console 控制台地址。
MINIO_ENDPOINT=127.0.0.1

# MinIO API Port（对象存储 API 端口），默认 9000。
MINIO_PORT=9000

# MinIO 是否使用 HTTPS。
MINIO_USE_SSL=false

# MinIO 访问密钥，开发环境可使用 minioadmin。
MINIO_ACCESS_KEY=minioadmin

# MinIO 密钥，开发环境可使用 minioadmin。
MINIO_SECRET_KEY=minioadmin

# =========================
# 小米 MiMo 模型
# =========================
# 切换到“云端 MiMo”时必填，Day63 会进一步升级到 Secrets 管理。
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key

# MiMo OpenAI 兼容接口地址；通常保持默认即可。
XIAOMI_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 前端下拉会传模型 id，默认首选 mimo-v2.5-pro。
# 可选值见 lib/mimo-models.ts：
# mimo-v2.5-pro
# mimo-v2.5
# mimo-v2.5-tts-voiceclone
# mimo-v2.5-tts-voicedesign
# mimo-v2.5-tts
# mimo-v2-pro
# mimo-v2-omni
# mimo-v2-flash
# mimo-v2-tts
