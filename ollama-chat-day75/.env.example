# 第74天：声明运行环境，可选 development、staging 或 production。
APP_ENV=development
# 第74天：声明服务监听端口。
PORT=3000
# 第74天：声明服务监听全部容器网卡。
HOSTNAME=0.0.0.0
# 第74天：声明 MySQL 服务地址，本机运行时可改为 127.0.0.1。
MYSQL_HOST=mysql
# 第74天：声明 MySQL 服务端口。
MYSQL_PORT=3306
# 第74天：声明 MySQL 数据库名称。
MYSQL_DATABASE=agent_runtime
# 第74天：声明 MySQL 用户名。
MYSQL_USER=agent
# 第74天：提供本地教学环境示例密码，真实生产必须改由 Secret Manager 注入。
MYSQL_PASSWORD=change-me-agent-password
# 第74天：声明 Redis 连接地址。
REDIS_URL=redis://redis:6379
# 第74天：声明 Redis 逻辑键前缀，隔离 Day74 数据。
REDIS_KEY_PREFIX=ollama:day75:
# 第74天：声明对象存储使用 MinIO Provider。
OBJECT_STORAGE_PROVIDER=minio
# 第74天：声明对象存储默认 Bucket。
OBJECT_STORAGE_BUCKET=agent-platform
# 第74天：声明 MinIO 服务地址。
MINIO_ENDPOINT=minio
# 第74天：声明 MinIO API 端口。
MINIO_PORT=9000
# 第74天：声明本地 MinIO 不启用 TLS。
MINIO_USE_SSL=false
# 第74天：提供本地教学环境 MinIO 用户名，真实生产必须改用安全密钥。
MINIO_ACCESS_KEY=agent-platform-admin
# 第74天：提供本地教学环境 MinIO 密码，真实生产必须改用安全密钥。
MINIO_SECRET_KEY=change-me-minio-password
# 第74天：声明 JWT 密钥只通过引用定位，不把真实值写入生产配置对象。
JWT_SECRET_REF=env:JWT_SECRET
# 第74天：提供本地教学环境 JWT 示例值，真实生产必须替换。
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# 第74天：声明生产链路采样率。
OBSERVABILITY_SAMPLING_RATE=0.2
# 第74天：声明当前平台发布版本。
PLATFORM_VERSION=1.0.0
# 第74天：声明当前 Git 提交标识，CI 中由流水线覆盖。
GIT_COMMIT=local-development
# 第74天：声明当前数据库迁移版本。
DATABASE_VERSION=005_knowledge
# 第74天：声明部署标识，CI 或发布系统应覆盖为不可变版本。
DEPLOYMENT_VERSION=day75-local
# 第74天：容器启动时启用严格启动校验。
ENABLE_STARTUP_VALIDATION=true
# 第74天：声明本地 Ollama 地址，容器内通过 host.docker.internal 访问 Windows 主机。
OLLAMA_API_URL=http://host.docker.internal:11434/api/chat
